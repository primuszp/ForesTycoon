<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>NU1701</NoWarn>
    <Platforms>AnyCPU</Platforms>
    <AssemblyName>ForesTycoon</AssemblyName>
    <RootNamespace>ForesTycoon</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ForesTycoon.Rules" />
    <EmbeddedResource Include="Assets/UI/forest-icons-transport.png" LogicalName="ForesTycoon.ForestIconsTransport.png" />
    <Using Include="ForesTycoon.Engine" />
    <Using Include="ForesTycoon.Ecology" />
    <Using Include="ForesTycoon.TreeModels" />
    <Using Include="ForesTycoon.Rendering" />
    <Using Include="ForesTycoon.Models" />
    <Using Include="ForesTycoon.Effects" />
    <Using Include="ForesTycoon.Map" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ForesTycoon.Engine/ForesTycoon.Engine.csproj" />
    <ProjectReference Include="../ForesTycoon.Rules/ForesTycoon.Rules.csproj" />
    <ProjectReference Include="../ForesTycoon.Ecology/ForesTycoon.Ecology.csproj" />
    <ProjectReference Include="../ForesTycoon.TreeModels/ForesTycoon.TreeModels.csproj" />
    <ProjectReference Include="../ForesTycoon.Rendering/ForesTycoon.Rendering.csproj" />
    <ProjectReference Include="../ForesTycoon.Models/ForesTycoon.Models.csproj" />
    <ProjectReference Include="../ForesTycoon.Effects/ForesTycoon.Effects.csproj" />
    <ProjectReference Include="../ForesTycoon.Map/ForesTycoon.Map.csproj" />
    <Content Include="../ForesTycoon.TreeModels/Generation/Dendro/LICENSE.txt" Link="Licenses/DendroKit-GPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ForesTycoon.TreeModels/Generation/Dendro/NOTICE.md" Link="Licenses/DendroKit-NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Wildlife/fish.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Buildings/sawmill.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Wildlife/elk.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Vehicles/log-truck.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- Locally installed purchased models (git-ignored); optional, the game falls back without them. -->
    <Content Include="Assets/Licensed/**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets/Licensed')" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

</Project>
