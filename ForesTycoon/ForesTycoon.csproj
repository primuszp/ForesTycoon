<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>NU1701</NoWarn>
    <Platforms>AnyCPU</Platforms>
    <AssemblyName>ForesTycoon</AssemblyName>
    <RootNamespace>ForesTycoon</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets/Forest/pine-tree-original.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/trees-low-poly-original.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/oak-trees-original.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/forest-pack-original.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/birch-original.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/Generated/*.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Forest/Generated/EZ-TREE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Wildlife/fish.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Buildings/sawmill.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Wildlife/elk.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Vehicles/log-truck.glb" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

</Project>
