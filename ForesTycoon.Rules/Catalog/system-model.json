      "modules": [
        "Utak és nyomok",
        "Járművek"
      ],
      "description": "Úthálózat, útállapot, nyomok, útvonal, járműmozgás és fogyasztás."
    },
    {
      "id": "economy",
      "name": "Gazdaság és fenntartás",
      "modules": [
        "Gazdaság",
        "Fenntartás"
      ],
      "description": "Bevétel, kiadás, üzemeltetés, kopás, meghibásodás és javítás."
    },
    {
      "id": "world",
      "name": "Világ és idő",
      "modules": [
        "Idő és vezérlés",
        "Terep"
      ],
      "description": "Órák, parancsok, mentés, terep és a világ létrehozása."
