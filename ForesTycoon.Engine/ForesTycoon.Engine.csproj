<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-agnostic runtime kit: fixed-step time, system scheduling, background jobs,
    animation timing and the GPU vertex layout. No knowledge of forests, terrain or OpenGL.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ForesTycoon.Engine</RootNamespace>
    <AssemblyName>ForesTycoon.Engine</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForesTycoon" />
    <InternalsVisibleTo Include="ForesTycoon.Ecology" />
    <InternalsVisibleTo Include="ForesTycoon.TreeModels" />
    <InternalsVisibleTo Include="ForesTycoon.Rendering" />
    <InternalsVisibleTo Include="ForesTycoon.Models" />
    <InternalsVisibleTo Include="ForesTycoon.Effects" />
    <InternalsVisibleTo Include="ForesTycoon.Tests" />
  </ItemGroup>

</Project>
